{
  "name": "markora-workspace",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter markora --filter './packages/extension-*' --filter markora-ui --filter demo dev",
    "dev:demo": "pnpm --filter demo dev",
    "dev:core": "pnpm --filter markora dev",
    "dev:ui": "pnpm --filter markora-ui dev",
    "build": "pnpm --filter markora build && pnpm run build:extensions && pnpm --filter markora-ui build && pnpm --filter demo build",
    "build:core": "pnpm --filter markora build",
    "build:extensions": "pnpm --filter './packages/extension-*' --if-present build",
    "build:ui": "pnpm --filter markora-ui build",
    "build:demo": "pnpm --filter demo build",
    "browser:install": "playwright install chromium firefox webkit",
    "check": "pnpm --filter markora build && pnpm --filter markora typecheck && pnpm --filter markora typecheck:api && pnpm --filter markora smoke:node-esm && pnpm run build:extensions && pnpm run typecheck:extensions && pnpm run smoke:extensions && pnpm --filter markora-ui build && pnpm --filter markora-ui typecheck && pnpm --filter markora-ui smoke:node-esm && pnpm --filter demo typecheck && pnpm typecheck:browser && pnpm test",
    "pack:core": "node ./scripts/release-core.mjs pack",
    "perf:benchmark": "pnpm build:core && node ./scripts/performance-benchmark.mjs --profile=baseline",
    "perf:ci": "node ./scripts/pack-smoke.mjs --report=performance-results/bundle.json && node ./scripts/performance-benchmark.mjs --profile=ci --check && node ./scripts/advanced-syntax-performance.mjs --check",
    "release:check": "node ./scripts/release-core.mjs check && pnpm run pack:smoke",
    "publish:core": "node ./scripts/release-core.mjs publish",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:required": "playwright test --grep @required",
    "typecheck:extensions": "pnpm --filter './packages/extension-*' --if-present typecheck",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit",
    "smoke:extensions": "pnpm --filter './packages/extension-*' --if-present smoke:node-esm",
    "pack:smoke": "node ./scripts/pack-smoke.mjs"
  }
}
